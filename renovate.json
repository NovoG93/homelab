{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "kustomize": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all helm chart updates into one PR to reduce noise",
      "matchDatasources": [
        "helm"
      ],
      "groupName": "helm-charts"
    },
    {
      "description": "Ignore the local certificate-provision chart which has no remote repo",
      "matchPackageNames": [
        "certificate-provision"
      ],
      "enabled": false
    }
  ]
}